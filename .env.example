# Compose 宿主机映射（docker compose up）
BASE_BIND_ADDRESS=127.0.0.1
BASE_PUBLIC_PORT=8181
TZ=Asia/Shanghai

# 首次初始化（空数据库）使用；未设置时进程内默认 ChangeMe123，生产环境请修改。
# 密码含 $ 时使用单引号包裹，避免 Compose 插值。
BASE_ADMIN_PASSWORD=ChangeMe123

# 以下为进程环境变量（本地 go run / 二进制启动时使用；Compose 镜像内已有默认值）
# BASE_HOST=127.0.0.1
# BASE_PORT=8181
# BASE_DATA_DIR=./data
# BASE_FRONTEND_DIR=../frontend/dist
# BASE_SECRET_KEY=
# BASE_PUBLIC_URL=http://127.0.0.1:8181
# BASE_API_TARGET=http://127.0.0.1:8181

# 视频 AI（可选）
# MJPEG 并发预览上限（预览复用共享取流解码器，此值限制的是并发连接数），默认 32
# BASE_VIDEO_AI_MAX_PREVIEW=32
# ONNX 推理 worker 命令（默认 python3 backend/workers/onnx/worker.py）
# BASE_VIDEO_AI_ONNX_WORKER=python3 backend/workers/onnx/worker.py
# 每个模型的 worker 进程数（默认 min(GOMAXPROCS,8)）；多路摄像头共模型时决定并行度
# BASE_VIDEO_AI_ONNX_WORKERS=4
# 帧缩放插值：approx（默认，快）| bilinear（精确，慢）
# BASE_VIDEO_AI_RESIZE=approx
